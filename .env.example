DJANGO_DEBUG=true
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
# Leave DATABASE_URL unset locally. Set it through Vercel Environment Variables.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Optional persistent paths; defaults are db.sqlite3 and media/ in this project.
# RESTAURANT_DATABASE_PATH=C:/restaurant-data/db.sqlite3
# RESTAURANT_MEDIA_ROOT=C:/restaurant-data/media
